# Copy to .env (git-ignored) and fill in.

# LLM for explanations, action plans and translation: any OpenAI-compatible provider.
# Without a key VisaShield still works: detection is fully local, explanations fall back to English templates.
# Groq (free tier, no card): https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Alternatives: Google AI Studio (free tier) -> LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#               Featherless -> LLM_BASE_URL=https://api.featherless.ai/v1

# Agentboxd forward-to-check inbox (https://agentboxd.com/app/api-keys)
AGENTBOXD_API_KEY=
AGENTBOXD_BASE_URL=https://api.agentboxd.com
AGENTBOXD_INBOX_ID=
AGENTBOXD_INBOX_ADDRESS=
# Only for webhook mode (deployed): the signing secret shown when you create the webhook
AGENTBOXD_WEBHOOK_SECRET=

# Domain-age lookups via RDAP (network). Set to 0 to disable.
ENABLE_RDAP=1
